{
  "format_version": 1,
  "name": "Crunch",
  "author": "libre-pedals",
  "description": "Overdrive moderado estilo TS/Bluesbreaker con gabinete 2x12 Crunch y Spring sutil",
  "chain": [
    {
      "id": "noise_gate-1",
      "pedal": "noise_gate",
      "enabled": true,
      "params": {
        "threshold_db": -60.0
      }
    },
    {
      "id": "overdrive-1",
      "pedal": "overdrive",
      "enabled": true,
      "params": {
        "drive_db": 15.0,
        "low_cut_hz": 320.0,
        "asymmetry": 25.0,
        "clean_blend": 15.0,
        "tone_hz": 4800.0,
        "level_db": -6.0
      }
    },
    {
      "id": "cabinet_ir-1",
      "pedal": "cabinet_ir",
      "enabled": true,
      "params": {
        "model": 1.0,
        "low_cut_hz": 80.0,
        "high_cut_hz": 8200.0,
        "mix": 100.0,
        "level_db": 0.0
      }
    },
    {
      "id": "reverb-1",
      "pedal": "reverb",
      "enabled": true,
      "params": {
        "mode": 2.0,
        "decay": 36.0,
        "predelay_ms": 10.0,
        "tone": 52.0,
        "mix": 15.0
      }
    }
  ],
  "preset_level_db": 0.0
}
