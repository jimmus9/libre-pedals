{
  "format_version": 1,
  "name": "Lead (Boost + Drive)",
  "author": "libre-pedals",
  "description": "Klon transparente empujando a TS-808, EQ Paramétrico, 4x12 High-Gain, Analog BBD Delay y Hall Reverb",
  "chain": [
    {
