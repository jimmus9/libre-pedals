      "params": {
        "threshold_db": -55.0
      }
    },
    {
      "id": "overdrive-1",
      "pedal": "overdrive",
      "label": "Transparent Boost",
      "enabled": true,
      "params": {
        "drive_db": 6.0,
        "low_cut_hz": 85.0,
        "asymmetry": 10.0,
        "clean_blend": 45.0,
        "tone_hz": 6800.0,
        "level_db": 4.0
      }
    },
    {
      "id": "overdrive-2",
      "pedal": "overdrive",
      "label": "Lead Drive",
      "enabled": true,
      "params": {
        "drive_db": 26.0,
        "low_cut_hz": 720.0,
        "asymmetry": 55.0,
        "clean_blend": 0.0,
        "tone_hz": 5200.0,
        "level_db": -12.0
      }
    },
    {
      "id": "parametric_eq-1",
      "pedal": "parametric_eq",
